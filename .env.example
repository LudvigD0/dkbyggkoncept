# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Production: https://www.dkbyggkoncept.se (canonical URLs, metadata, sitemap and CORS).
# Local: http://localhost:3000. No trailing slash.
# Vercel Preview: omit to use VERCEL_URL automatically, or set your fixed preview domain.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Instagram: 32 random bytes encoded as base64. Keep the same key for this database.
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
# Enter the long-lived Instagram Login access token in Payload Admin, never NEXT_PUBLIC_*.

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# S3-compatible media storage (all five required when enabled)
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Resend: use an address on a verified sending domain
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@dkbyggkoncept.se
RESEND_FROM_NAME=DK Byggkoncept
